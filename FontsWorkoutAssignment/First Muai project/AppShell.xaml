<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="First_Muai_project.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:First_Muai_project"
    xmlns:service="clr-namespace:First_Muai_project.Service"
    Title="First_Muai_project">

    <ShellContent
        Title="Fonts Workout"
        ContentTemplate="{DataTemplate service:FontsWorkout}"
        Route="FontsWorkout" />

    <ShellContent
        Title="Home"
        ContentTemplate="{DataTemplate local:MainPage}"
        Route="MainPage" />

</Shell>

